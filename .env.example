# Documentation only; never commit real secrets.
FACELESSREELS_REVENUE_HMAC_KEY=replace-with-a-long-random-secret
FACELESSREELS_DB=data/facelessreels.sqlite3
FACELESSREELS_PROFIT_TARGET_USD=5.00
FACELESSREELS_MAX_WORKERS=3
FACELESSREELS_MAX_GENERATIONS=2

# Optional real AI scripts. No API request occurs unless the CLI receives --ai.
# Google Gemini is the default. Create a key at https://aistudio.google.com/.
FACELESSREELS_AI_PROVIDER=gemini
GEMINI_API_KEY=
FACELESSREELS_AI_MODEL=gemini-3.6-flash
# Optional endpoint override. For Gemini, leave unset to build the model endpoint automatically.
# FACELESSREELS_AI_BASE_URL=

# Optional NVIDIA fallback:
# FACELESSREELS_AI_PROVIDER=nvidia
# NVIDIA_API_KEY=
# FACELESSREELS_AI_MODEL=stg/nvidia/nemotron-3.5-bolt-e4b
# FACELESSREELS_AI_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions

# Optional OpenAI-compatible alternative:
# FACELESSREELS_AI_PROVIDER=openai
# OPENAI_API_KEY=
# FACELESSREELS_AI_MODEL=gpt-4o-mini
# FACELESSREELS_AI_BASE_URL=https://api.openai.com/v1/chat/completions
